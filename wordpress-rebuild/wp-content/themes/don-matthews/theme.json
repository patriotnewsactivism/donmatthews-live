{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {"slug":"ink","name":"Ink","color":"#0A0A0A"},
        {"slug":"panel","name":"Panel","color":"#121212"},
        {"slug":"panel-alt","name":"Panel Alt","color":"#181818"},
        {"slug":"gold","name":"Gold","color":"#C9A84C"},
        {"slug":"gold-soft","name":"Soft Gold","color":"#D7BE79"},
        {"slug":"paper","name":"Paper","color":"#F5F2E8"},
        {"slug":"mist","name":"Mist","color":"#A7A7A7"},
        {"slug":"line","name":"Line","color":"#2A2A2A"}
      ]
    },
    "spacing": {
      "units": ["px","rem","vw","vh","%"],
      "spacingSizes": [
        {"slug":"20","name":"2XS","size":"0.5rem"},
        {"slug":"30","name":"XS","size":"0.75rem"},
        {"slug":"40","name":"S","size":"1rem"},
        {"slug":"50","name":"M","size":"1.5rem"},
        {"slug":"60","name":"L","size":"2.5rem"},
        {"slug":"70","name":"XL","size":"4rem"},
        {"slug":"80","name":"2XL","size":"6rem"}
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Inter / System Sans",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        {"slug":"xs","name":"XS","size":"0.78rem"},
        {"slug":"sm","name":"Small","size":"0.9rem"},
        {"slug":"md","name":"Medium","size":"1rem"},
        {"slug":"lg","name":"Large","size":"1.25rem"},
        {"slug":"xl","name":"XL","size":"clamp(1.6rem,3vw,2.4rem)"},
        {"slug":"2xl","name":"2XL","size":"clamp(2.4rem,6vw,5.5rem)"}
      ]
    },
    "border": {"radius": true,"style": true,"width": true,"color": true}
  },
  "styles": {
    "color": {"background":"var:preset|color|ink","text":"var:preset|color|paper"},
    "typography": {"fontFamily":"var:preset|font-family|sans","lineHeight":"1.65"},
    "elements": {
      "heading": {"color":{"text":"var:preset|color|paper"},"typography":{"fontWeight":"700","lineHeight":"1.05","letterSpacing":"-0.025em"}},
      "link": {"color":{"text":"var:preset|color|gold"},":hover":{"color":{"text":"var:preset|color|gold-soft"}}},
      "button": {"color":{"background":"var:preset|color|gold","text":"var:preset|color|ink"},"border":{"radius":"6px","width":"0"},"typography":{"fontWeight":"700"},"spacing":{"padding":{"top":"0.75rem","right":"1.1rem","bottom":"0.75rem","left":"1.1rem"}}}
    },
    "blocks": {
      "core/group": {"spacing":{"blockGap":"1.5rem"}},
      "core/navigation": {"typography":{"fontSize":"0.9rem","fontWeight":"600"}},
      "core/separator": {"color":{"background":"var:preset|color|line"}},
      "core/quote": {"border":{"left":{"color":"var:preset|color|gold","width":"3px"}},"spacing":{"padding":{"left":"1.5rem"}}}
    }
  }
}
