{
  "name": "don-voice-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Don Matthews voice agent: x.ai Realtime + Twilio telephony, Supabase memory, GitHub admin tools",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsx src/selftest.ts",
    "ingest": "tsx src/ingest.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3"
  }
}