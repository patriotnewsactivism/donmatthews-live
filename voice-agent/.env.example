# x.ai Realtime (required)
XAI_API_KEY=
XAI_AGENT_ID=agent_BVrCNfKW2CpeZyH2

# Public HTTPS origin of this service (used to build the TeXML Stream wss URL)
PUBLIC_BASE_URL=https://voice.yourhost.example

# Shared secret on the media-stream WebSocket URL
STREAM_TOKEN=

# Supabase persistence (same project as donmatthews.live / BuildMyBot)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Owner access ("sudo"): caller ID + passcode. Set these only in server env.
OWNER_PHONE=+18328804970
ADMIN_PASSCODE=
MAX_VERIFY_ATTEMPTS=3

# Admin tools via GitHub API (fine-grained PAT). Leave blank to disable admin tools.
GITHUB_TOKEN=
GITHUB_USER=patriotnewsactivism

# Optional override; otherwise the Support page links are used.
DONATION_INFO_TEXT=

PORT=8080
