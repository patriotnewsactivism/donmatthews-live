# Telnyx managed Conversational AI (primary voice path)
TELNYX_API_KEY=
# Optional after provisioning: if omitted, the provisioner stores the assistant ID in Supabase voice_memory.
TELNYX_ASSISTANT_ID=
TELNYX_AI_MODEL=moonshotai/Kimi-K2.5
TELNYX_AI_VOICE=Telnyx.NaturalHD.andersen_johan
TELNYX_STT_MODEL=deepgram/flux
# Optional explicit webhook secret. If omitted and TELNYX_API_KEY is present, a one-way derived token is used.
TELNYX_TOOL_TOKEN=
# Optional unless placing outbound calls through /api/voice/telnyx/call.
TELNYX_TEXML_APP_ID=
TELNYX_CALLER_ID=

# Legacy xAI Realtime/WebSocket bridge (rollback only)
XAI_API_KEY=
XAI_AGENT_ID=agent_BVrCNfKW2CpeZyH2
STREAM_TOKEN=

# Canonical public HTTPS origin used for Telnyx webhook tools and legacy WebSocket URLs.
PUBLIC_BASE_URL=https://www.donmatthews.live

# Supabase persistence (same project as donmatthews.live)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Owner access ("sudo"): caller ID + passcode. Set these only in server env.
OWNER_PHONE=+18328804970
ADMIN_PASSCODE=
MAX_VERIFY_ATTEMPTS=3

# Admin tools via GitHub API (fine-grained PAT). Leave blank to disable admin tools.
GITHUB_TOKEN=
GITHUB_USER=patriotnewsactivism

# Optional override; otherwise the Support page links are used.
DONATION_INFO_TEXT=

PORT=8080
