# Don Matthews live — environment variables.
# Copy to .env.local for local dev. In production, set these in Vercel
# (Project -> Settings -> Environment Variables). NEVER commit real values.

# Don live-avatar paywall (see docs/don-paywall.md).
# Supabase project (same project as the existing lead capture).
SUPABASE_URL=
# Service-role key — SERVER ONLY. The paywall tables allow only this key.
SUPABASE_SERVICE_ROLE_KEY=
# Hosted Anam stage server (server-side mint + browser socket).
DON_STAGE_URL=
NEXT_PUBLIC_DON_STAGE_URL=
# Stripe — $1/minute minute packs via Checkout.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Shared secret so the stage server can report usage to /api/don/usage.
# Set the SAME value in the stage server .env.
DON_PAYWALL_SHARED_SECRET=
# Optional extra salt for the IP hash. Same value everywhere or hashes change.
DON_PAYWALL_IP_SALT=
